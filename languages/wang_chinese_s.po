msgstr "你应该知道这是个棋盒叭……"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE.TEACH_RECIPE
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE.TEACH_RECIPE"
msgid "I'll teach you a recipe."
msgstr "我教你一个配方。"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE.TEACH_RECIPE_INTERRUPTED
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE.TEACH_RECIPE_INTERRUPTED"
msgid "Don't interrupt... let me finish."
msgstr "别打断……让我教完。"

#. STRINGS.CHARACTERS.GENERIC.ACTIONFAIL.TEACH_RECIPE.TEACH_NONE
msgctxt "STRINGS.CHARACTERS.GENERIC.ACTIONFAIL.TEACH_RECIPE.TEACH_NONE"

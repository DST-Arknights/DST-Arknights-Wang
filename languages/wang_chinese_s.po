#. STRINGS.UI.ARK_SKILL.LEVEL_DESC.WANG.1
msgctxt "STRINGS.UI.ARK_SKILL.LEVEL_DESC.WANG.1"
msgid "-Detonate deployed black stones within range, each dealing %sx stone damage"
msgstr "-引爆指定范围内的已部署黑子，每枚造成 %s 倍黑子伤害"

#. STRINGS.UI.ARK_SKILL.LEVEL_DESC.WANG.2
msgctxt "STRINGS.UI.ARK_SKILL.LEVEL_DESC.WANG.2"
msgid "Costs 10 SP\nCan store 4 charges"
msgstr "消耗10点SP\n可储存4次"

#. STRINGS.UI.ARK_SKILL.LEVEL_DESC.WANG.3
msgctxt "STRINGS.UI.ARK_SKILL.LEVEL_DESC.WANG.3"
msgid "Costs 181 SP\nWhile active, drains 1 SP per second"
msgstr "消耗10点SP\n获得40发弹药；期间通过拈子剑落子时向四方追加黑子"

#. STRINGS.CHARACTERS.WANG.ACTIONFAIL.BUILD.WANG_MASTER_FAIL
msgctxt "STRINGS.CHARACTERS.WANG.ACTIONFAIL.BUILD.WANG_MASTER_FAIL"

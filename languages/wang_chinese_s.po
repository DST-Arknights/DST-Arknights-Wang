msgstr "学到了 %s"

#. STRINGS.CHARACTER_DESCRIPTIONS.wang
msgctxt "STRINGS.CHARACTER_DESCRIPTIONS.wang"
msgid "A quiet chess player, trading his life for the board"
msgstr "*沉默寡言的弈者，以黑子为棋，以性命为盘\n*生命随成长逐渐降低，黑子能力随之增强\n*无法独自搬运重物，骑乘驯牛方可\n*擅长阅读书籍，配方需逐一掌握"

#. STRINGS.CHARACTERS.WANG.ACTIONFAIL.PICKUP.NO_HEAVY_LIFTING
msgctxt "STRINGS.CHARACTERS.WANG.ACTIONFAIL.PICKUP.NO_HEAVY_LIFTING"
msgid "Too heavy to carry alone..."
msgstr "此物非一人能负……"

